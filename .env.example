# Copy to .env and fill in. Every value below is the default unless marked REQUIRED.

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# REQUIRED: the review is refused (HTTP 503 / CLI error) without it.
ANTHROPIC_API_KEY=

# --- GitHub ----------------------------------------------------------------
# Optional for public repos (60 requests/hour without it); needed for private repos.
# A fine-grained token with read-only "Pull requests" and "Contents" access is enough.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Review loop -----------------------------------------------------------
# Accept when score (rubric total / 10) is at least this.
ACCEPT_SCORE_THRESHOLD=8
# Maximum number of fix attempts.
MAX_FIX_ITERATIONS=5
# If a re-review improves the score by less than this, stop and flag for a human.
MIN_SCORE_IMPROVEMENT=0.3

# --- Compiler / test tool --------------------------------------------------
# Per-step timeout in seconds (py_compile, pytest).
EXECUTION_TIMEOUT_SECONDS=60
# WARNING: pytest EXECUTES the PR's code on this machine. There is no real sandbox
# (only a temp dir, a scrubbed environment and a timeout). Leave false unless you trust
# the repository, or run this service inside a container/VM.
# py_compile (syntax check) always runs; it does not execute code.
ENABLE_TEST_EXECUTION=false

# --- Logging ---------------------------------------------------------------
# DEBUG also prints tool output per step.
LOG_LEVEL=INFO
